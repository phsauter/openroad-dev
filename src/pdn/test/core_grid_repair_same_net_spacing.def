VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
DESIGN same_net_spacing ;

UNITS DISTANCE MICRONS 2000 ;

DIEAREA ( 0 0 ) ( 200000 80000 ) ;

ROW ROW_0 FreePDK45_38x28_10R_NP_162NW_34O 20000 20000 N DO 400 BY 1 STEP 380 0 ;
ROW ROW_1 FreePDK45_38x28_10R_NP_162NW_34O 20000 60000 FS DO 400 BY 1 STEP 380 0 ;

COMPONENTS 0 ;
END COMPONENTS

PINS 0 ;
END PINS

SPECIALNETS 1 ;
- VDD + USE POWER
  + FIXED metal4 6000 + SHAPE STRIPE ( 40000 63800 ) ( * 76000 ) ;
END SPECIALNETS

NETS 1 ;
- VSS + USE GROUND ;
END NETS

END DESIGN
